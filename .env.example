# GEMINI_API_KEY: Required for server-side Gemini AI daily quiz generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_CODE: Shared initial administrator access gate code (e.g. 7894).
# Validated strictly server-side; never exposed in frontend code.
ADMIN_ACCESS_CODE=

